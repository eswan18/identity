package views

// ConnectedAppAccess is one thing a connected app was allowed to reach: an
// API (resource) and what it may do there, described as the consent screen
// described it. ResourceName is empty for access to the user's identity
// account itself (sign-in and profile scopes, no API).
type ConnectedAppAccess struct {
	ResourceName      string
	ResourceHost      string
	ScopeDescriptions []ScopeDescription
}

// ConnectedApp is one app the user has given consent to.
type ConnectedApp struct {
	// ClientRef identifies the client to the disconnect form (oauth_clients.id).
	ClientRef string
	// Name is who the app is, named as on the consent screen: a registered
	// client's name, or for a client identified by a metadata document, the
	// host serving that document.
	Name string
	// ClaimedName is the name a metadata-document client gives itself, shown
	// as its claim. Empty otherwise.
	ClaimedName string
	// ClientURI is a metadata-document client's client_id URL, shown in full so
	// the user can tell the real app from one with a lookalike name. Empty for
	// registered clients.
	ClientURI string
	Access    []ConnectedAppAccess
	// ConnectedAt is when consent was first given; ConnectedAtISO is the same
	// instant for the <time> element. LastUsed is when a token was last issued
	// to the app for this user, empty if no record of one remains.
	ConnectedAt    string
	ConnectedAtISO string
	LastUsed       string
	LastUsedISO    string
}

// ConnectedAppsView holds everything the connected-apps page renders.
type ConnectedAppsView struct {
	Apps      []ConnectedApp
	Success   string
	Error     string
	CSRFToken string
}

// ConnectedApps lists the apps the user has allowed to access their account,
// with a disconnect form for each. Disconnecting is behind a <details>
// disclosure that explains what it does, so it takes a deliberate second
// click (the same pattern as disabling MFA on the account settings page).
templ ConnectedApps(data ConnectedAppsView) {
	@Layout("Connected Apps") {
		<div class="mb-4">
			<a href="/oauth/account-settings" class="link link-primary text-sm">← Back to account settings</a>
		</div>
		<div class="text-center mb-8">
			<h1 class="card-title justify-center text-2xl">Connected Apps</h1>
			<p class="text-sm text-base-content/60">Apps you have allowed to access your account</p>
		</div>
		if data.Error != "" {
			@alertError(data.Error)
		}
		if data.Success != "" {
			@alertSuccess(data.Success)
		}
		if len(data.Apps) == 0 {
			<p class="text-sm text-base-content/60 text-center mb-6">No apps are connected to your account.</p>
		} else {
			<ul class="flex flex-col gap-4 mb-6" aria-label="Connected apps">
				for _, app := range data.Apps {
					<li class="p-4 bg-base-200 rounded-lg">
						@connectedApp(app, data.CSRFToken)
					</li>
				}
			</ul>
		}
		@footer()
	}
}

templ connectedApp(app ConnectedApp, csrfToken string) {
	<h2 class="text-base font-semibold">{ app.Name }</h2>
	if app.ClaimedName != "" {
		<p class="text-xs text-base-content/60">It calls itself “{ app.ClaimedName }”</p>
	}
	if app.ClientURI != "" {
		<p class="text-xs text-base-content/60 break-all">Identified by <span class="font-mono">{ app.ClientURI }</span></p>
	}
	<div class="mt-3">
		<p class="text-sm font-medium mb-1">Can access:</p>
		for _, access := range app.Access {
			<div class="mb-2">
				<p class="text-sm">
					if access.ResourceName != "" {
						<strong>{ access.ResourceName }</strong>
						if access.ResourceHost != "" && access.ResourceHost != access.ResourceName {
							<span class="text-base-content/60">({ access.ResourceHost })</span>
						}
					} else {
						<strong>Your account</strong>
					}
				</p>
				if len(access.ScopeDescriptions) > 0 {
					<ul class="list-disc list-inside text-sm text-base-content/80">
						for _, sd := range access.ScopeDescriptions {
							<li>{ sd.Description }</li>
						}
					</ul>
				}
			</div>
		}
	</div>
	<dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs text-base-content/60 mt-2">
		<dt>Connected</dt>
		<dd><time datetime={ app.ConnectedAtISO }>{ app.ConnectedAt }</time></dd>
		<dt>Last used</dt>
		<dd>
			if app.LastUsed != "" {
				<time datetime={ app.LastUsedISO }>{ app.LastUsed }</time>
			} else {
				Not recorded
			}
		</dd>
	</dl>
	<details class="mt-3">
		<summary class="text-sm text-error cursor-pointer hover:underline">Disconnect</summary>
		<form method="POST" action="/oauth/connected-apps/disconnect" class="mt-3 p-3 bg-base-100 rounded-lg">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="client" value={ app.ClientRef }/>
			<p class="text-sm mb-3">
				<strong>{ app.Name }</strong> will be signed out and lose access to your account right away.
				If you use it again, it will have to ask for your permission again.
			</p>
			<button type="submit" name="confirm" value="yes" class="btn btn-error btn-sm w-full">Yes, disconnect { app.Name }</button>
		</form>
	</details>
}
