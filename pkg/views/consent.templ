package views

// ScopeDescription maps a scope string to a human-readable description shown
// in the consent screen's permission list. Moved here from
// httpserver.ScopeDescription (previously in pkg/httpserver/templates.go):
// pkg/views cannot import pkg/httpserver (the dependency runs the other way,
// httpserver -> views), so the type that ConsentView.ScopeDescriptions needs
// has to live in this package. pkg/httpserver/oauth.go now builds
// []views.ScopeDescription directly.
type ScopeDescription struct {
	Scope       string
	Description string
}

// ConsentView holds everything the consent page renders (spec section 8: who
// is asking, what for, and where the answer goes). AuthorizeQuery is the
// authorization request being approved or denied (see AuthorizeQueryField).
type ConsentView struct {
	Error string
	// ClientName is who is asking: a registered client's name, or for a
	// client identified by a metadata document, the host serving it.
	ClientName string
	// ClaimedName is the name a metadata-document client gives itself, shown
	// beneath ClientName as its claim rather than as fact. Empty otherwise.
	ClaimedName string
	// ResourceName and ResourceHost say which API the access is for. Empty
	// when the token is for identity itself.
	ResourceName      string
	ResourceHost      string
	ScopeDescriptions []ScopeDescription
	// RedirectHost is where the answer goes: the redirect URI's host.
	RedirectHost string
	// LoopbackOnly is set when every redirect URI the client has is a
	// loopback one, so the page warns that the app runs on this computer.
	LoopbackOnly   bool
	AuthorizeQuery string
	CSRFToken      string
}

// Consent renders the OAuth authorization/consent screen. The authorization
// request travels as one hidden input so the "allow"/"deny" decision posted
// back to /oauth/consent carries it whole, to be re-validated there. The
// scope-item SVG below is a checkmark
// glyph distinct from partials' iconSuccess (different classes/attributes,
// no aria-hidden), so it is inlined here rather than reused.
templ Consent(data ConsentView) {
	@Layout("Authorize Application") {
		<div class="text-center mb-6">
			<h1 class="card-title justify-center text-2xl">Authorize Application</h1>
			<p class="text-sm text-base-content/60 mt-2">
				<strong>{ data.ClientName }</strong> is requesting access to your account
			</p>
			if data.ClaimedName != "" {
				<p class="text-xs text-base-content/60 mt-1">It calls itself “{ data.ClaimedName }”</p>
			}
		</div>
		if data.Error != "" {
			@alertError(data.Error)
		}
		if data.LoopbackOnly {
			<div class="alert alert-warning mb-6" role="alert">
				@iconError()
				<span>This app runs on your computer. Only continue if you started this sign-in yourself.</span>
			</div>
		}
		if data.ResourceName != "" {
			<div class="mb-4">
				<p class="text-sm font-medium mb-1">Access to:</p>
				<p class="text-sm">
					<strong>{ data.ResourceName }</strong>
					<span class="text-base-content/60">({ data.ResourceHost })</span>
				</p>
			</div>
		}
		<div class="mb-6">
			<p class="text-sm font-medium mb-3">This application will be able to:</p>
			<ul class="space-y-2">
				for _, sd := range data.ScopeDescriptions {
					<li class="flex items-start gap-2 text-sm">
						<svg class="shrink-0 mt-0.5 text-primary" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
							<path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm3.78 5.28-4.5 6a.75.75 0 0 1-1.18.02l-2.25-2.5a.75.75 0 1 1 1.12-1l1.63 1.81 3.92-5.23a.75.75 0 1 1 1.26.9z"></path>
						</svg>
						<span>{ sd.Description }</span>
					</li>
				}
			</ul>
		</div>
		<p class="text-xs text-base-content/60 mb-4">
			Your answer will be sent to <strong>{ data.RedirectHost }</strong>.
		</p>
		<form method="POST" action="/oauth/consent" class="space-y-3">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<input type="hidden" name={ AuthorizeQueryField } value={ data.AuthorizeQuery }/>
			<button type="submit" name="decision" value="allow" class="btn btn-primary w-full">Allow</button>
			<button type="submit" name="decision" value="deny" class="btn btn-outline w-full">Deny</button>
		</form>
		@footer()
	}
}
