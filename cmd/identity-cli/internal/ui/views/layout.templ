package views

// EnvBanner says which database the panel is editing. It is on every page.
type EnvBanner struct {
	Label  string // "PROD", "STAGING" or "CUSTOM: <host>"
	Prod   bool
	Custom bool
}

// Page is what every view gets from the server.
type Page struct {
	Title string
	Env   EnvBanner
	CSRF  string
}

func (p Page) docTitle() string {
	if p.Env.Prod {
		return "[PROD] " + p.Title + " · identity admin"
	}
	return p.Title + " · identity admin"
}

func (e EnvBanner) badgeClass() string {
	switch {
	case e.Prod:
		return "bg-error text-error-content"
	case e.Custom:
		return "bg-neutral text-neutral-content"
	default:
		return "bg-warning text-warning-content"
	}
}

// Layout is the panel's page shell: the environment bar, nav, and the page.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ p.docTitle() }</title>
			<link rel="stylesheet" href="/assets/style.css"/>
		</head>
		<body class="min-h-screen bg-base-200 text-base-content">
			<div class={ "w-full text-center font-bold tracking-widest py-1 text-sm", p.Env.badgeClass() }>
				{ p.Env.Label }
				if p.Env.Prod {
					<span class="font-normal tracking-normal">: changes affect real users</span>
				}
			</div>
			<div class="navbar bg-base-100 shadow-sm px-6">
				<div class="flex-1">
					<a href="/clients" class="text-lg font-semibold">identity admin</a>
				</div>
				<ul class="menu menu-horizontal gap-1">
					<li><a href="/clients">Clients</a></li>
					<li><a href="/resources">Resources</a></li>
				</ul>
			</div>
			<main class="max-w-5xl mx-auto p-6">
				<h1 class="text-2xl font-bold mb-4">{ p.Title }</h1>
				{ children... }
			</main>
			@copyScript()
		</body>
	</html>
}

// CSRFField is the hidden token every POST form carries.
templ CSRFField(p Page) {
	<input type="hidden" name="csrf" value={ p.CSRF }/>
}

// ErrorAlert shows a message, if there is one.
templ ErrorAlert(msg string) {
	if msg != "" {
		<div role="alert" class="alert alert-error mb-4 whitespace-pre-wrap"><span>{ msg }</span></div>
	}
}

// NoticeAlert shows an informational message, if there is one.
templ NoticeAlert(msg string) {
	if msg != "" {
		<div role="alert" class="alert alert-warning mb-4"><span>{ msg }</span></div>
	}
}

// CopyButton copies value to the clipboard. One delegated listener
// (copyScript, in Layout) handles every button.
templ CopyButton(value string) {
	<button type="button" class="btn btn-ghost btn-xs align-middle" data-copy={ value } title="Copy to clipboard">Copy</button>
}

templ copyScript() {
	<script>
		document.addEventListener("click", function (e) {
			var b = e.target.closest("[data-copy]");
			if (!b) return;
			navigator.clipboard.writeText(b.dataset.copy).then(function () {
				b.textContent = "Copied";
				setTimeout(function () { b.textContent = "Copy"; }, 1200);
			}, function () {
				b.textContent = "Copy failed";
			});
		});
	</script>
}
