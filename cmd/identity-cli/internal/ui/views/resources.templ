package views

import (
	"net/url"
	"sort"

	"github.com/eswan18/identity/pkg/db"
)

// ScopeRow is one row of the scopes editor.
type ScopeRow struct {
	Name        string
	Description string
}

// ResourceFormView is the resource create or edit form.
type ResourceFormView struct {
	New            bool
	URI            string
	Name           string
	Scopes         []ScopeRow
	DynamicClients bool
	Fingerprint    string
	UsedBy         []db.ListClientsReferencingResourceRow
	Error          string
	Notice         string
}

func ResourceHref(path, uri string) string {
	return path + "?uri=" + url.QueryEscape(uri)
}

// ScopeRows turns a scope map into sorted rows plus blanks to add new ones.
func ScopeRows(scopes map[string]string, blanks int) []ScopeRow {
	rows := make([]ScopeRow, 0, len(scopes)+blanks)
	for name, desc := range scopes {
		rows = append(rows, ScopeRow{Name: name, Description: desc})
	}
	sort.Slice(rows, func(i, j int) bool { return rows[i].Name < rows[j].Name })
	for i := 0; i < blanks; i++ {
		rows = append(rows, ScopeRow{})
	}
	return rows
}

func (v ResourceFormView) action() string {
	if v.New {
		return "resources/new"
	}
	return ResourceHref("resource/review", v.URI)
}

func referenceKind(c db.ListClientsReferencingResourceRow) string {
	if c.IsDefault {
		return "default resource"
	}
	return "allow-list"
}

templ ResourceList(p Page, resources []db.OauthResource) {
	@Layout(p) {
		<div class="mb-4"><a class="btn btn-primary btn-sm" href="resources/new">New resource</a></div>
		<div class="overflow-x-auto bg-base-100 rounded-box shadow">
			<table class="table">
				<thead>
					<tr><th>Name</th><th>URI (token aud)</th><th>Dynamic clients</th></tr>
				</thead>
				<tbody>
					for _, r := range resources {
						<tr class="hover">
							<td><a class="link link-primary font-medium" href={ templ.SafeURL(ResourceHref("resource", r.Uri)) }>{ r.Name }</a></td>
							<td class="font-mono text-xs break-all">{ r.Uri }</td>
							<td>
								if r.DynamicClients {
									yes
								} else {
									no
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ ResourceForm(p Page, v ResourceFormView) {
	@Layout(p) {
		@ErrorAlert(v.Error)
		@NoticeAlert(v.Notice)
		<form method="post" action={ templ.SafeURL(v.action()) } class="bg-base-100 rounded-box shadow p-6 space-y-4 max-w-3xl">
			@CSRFField(p)
			<input type="hidden" name="fingerprint" value={ v.Fingerprint }/>
			if v.New {
				<label class="form-control w-full">
					<div class="label"><span class="label-text font-semibold">URI</span><span class="label-text-alt">https; becomes every token's aud; can't change later</span></div>
					<input class="input input-bordered w-full font-mono text-sm" name="uri" value={ v.URI } required/>
				</label>
			} else {
				<div class="text-sm"><span class="font-semibold">URI:</span> <span class="font-mono break-all">{ v.URI }</span> @CopyButton(v.URI)</div>
			}
			<label class="form-control w-full">
				<div class="label"><span class="label-text font-semibold">Name</span><span class="label-text-alt">shown on the consent screen</span></div>
				<input class="input input-bordered w-full" name="name" value={ v.Name } required/>
			</label>
			<div>
				<div class="label"><span class="label-text font-semibold">Scopes</span><span class="label-text-alt">name and the text the consent screen shows; clear both to remove</span></div>
				<div class="space-y-2">
					for _, row := range v.Scopes {
						<div class="flex gap-2">
							<input class="input input-bordered input-sm w-1/3 font-mono" name="scope_name" value={ row.Name } placeholder="name:read"/>
							<input class="input input-bordered input-sm flex-1" name="scope_desc" value={ row.Description } placeholder="Read your …"/>
						</div>
					}
				</div>
			</div>
			<label class="label cursor-pointer justify-start gap-3">
				<input type="checkbox" class="checkbox" name="dynamic_clients" checked?={ v.DynamicClients }/>
				<span class="label-text">Dynamic clients: let clients identified by a metadata document (e.g. Claude) request this resource</span>
			</label>
			if !v.New {
				<div>
					<div class="label"><span class="label-text font-semibold">Used by</span></div>
					if len(v.UsedBy) == 0 {
						<p class="text-sm opacity-60">No client.</p>
					}
					<ul class="list-disc ml-6 text-sm">
						for _, c := range v.UsedBy {
							<li><a class="link" href={ templ.SafeURL(ClientHref("client", c.ClientID)) }>{ c.Name }</a> ({ referenceKind(c) })</li>
						}
					</ul>
				</div>
			}
			<div class="flex gap-2">
				if v.New {
					<button class="btn btn-primary" type="submit">Create resource</button>
				} else {
					<button class="btn btn-primary" type="submit">Review changes</button>
					<a class="btn btn-ghost" href={ templ.SafeURL(ResourceHref("resource/delete", v.URI)) }>Delete…</a>
				}
			</div>
		</form>
	}
}

templ ResourceDelete(p Page, r db.OauthResource, errMsg string) {
	@Layout(p) {
		@ErrorAlert(errMsg)
		<form method="post" action={ templ.SafeURL(ResourceHref("resource/delete", r.Uri)) } class="bg-base-100 rounded-box shadow p-6 space-y-4 max-w-xl">
			@CSRFField(p)
			<p>Delete <span class="font-semibold">{ r.Name }</span> (<span class="font-mono text-xs break-all">{ r.Uri }</span>)? Tokens already issued for it keep working until they expire.</p>
			if p.Env.Prod {
				<label class="form-control w-full">
					<div class="label"><span class="label-text">Type the resource's name to confirm</span></div>
					<input class="input input-bordered w-full" name="confirm_name" autocomplete="off"/>
				</label>
			}
			<div class="flex gap-2">
				<button class="btn btn-error" type="submit">Delete</button>
				<a class="btn btn-ghost" href={ templ.SafeURL(ResourceHref("resource", r.Uri)) }>Cancel</a>
			</div>
		</form>
	}
}
